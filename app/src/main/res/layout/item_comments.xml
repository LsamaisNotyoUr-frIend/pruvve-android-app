<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/mid_dark_gray">

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="160dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline242"
        app:layout_constraintEnd_toStartOf="@+id/guideline243"
        app:layout_constraintStart_toStartOf="@+id/guideline245"
        app:layout_constraintTop_toTopOf="@+id/guideline246">

        <WebView
            android:id="@+id/wvCommentProfilePicture"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvCommentsUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/my_exo"
        android:text="userName"
        android:textColor="@color/white"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvUserComments"
        app:layout_constraintEnd_toStartOf="@+id/guideline244"
        app:layout_constraintStart_toStartOf="@+id/guideline243"
        app:layout_constraintTop_toTopOf="@+id/guideline246"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvUserComments"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/my_exo"
        android:layout_marginStart="10dp"
        android:maxLines="4"
        android:text="comment of the century right here yoiu aint gonna find any better than this to grab your attention"
        android:layout_marginBottom="5dp"
        android:textColor="@color/white"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@+id/tvViewMore"
        app:layout_constraintEnd_toStartOf="@+id/guideline244"
        app:layout_constraintStart_toStartOf="@+id/guideline243"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvViewMore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="  View more"
        android:textColor="@color/moderate_green"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline244"
        tools:ignore="HardcodedText" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline242"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.52238804" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline243"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.20" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline244"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline245"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline246"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />
</androidx.constraintlayout.widget.ConstraintLayout>